package views

templ Layout() {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Wona Labs</title>
        <!-- Tailwind v4 Runtime CDN -->
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    </head>
    <body class="bg-slate-950 text-slate-100 flex min-h-screen flex-col items-center justify-center font-sans antialiased">
        <main class="text-center p-6 space-y-4">
            <h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
                Wona Labs
            </h1>
            <p class="text-lg text-slate-400 font-medium tracking-wide border border-slate-800 rounded-full px-6 py-2 bg-slate-900/50 backdrop-blur-sm">
                I know why you're here. Be patient... &#x1F60C;
            </p>
        </main>
    </body>
    </html>
}